{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyunseob-me",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "assets": {
    "directory": "./public"
  },
  "routes": [
    {
      "pattern": "hyunseob.me",
      "custom_domain": true
    },
    {
      "pattern": "www.hyunseob.me",
      "custom_domain": true
    }
  ]
}
